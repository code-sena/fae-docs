C4Container
    title Container Diagram — FaceAttend EDU

    Person(student, "Student / Learner", "Registers attendance with a facial scan from the mobile or web app")
    Person(instructor, "Instructor", "Opens and closes class sessions and reviews attendance")
    Person(admin, "School Administrator", "Manages schools, programs, schedules and configuration")

    System_Boundary(faceattend, "FaceAttend EDU") {

        Container(web, "Web App", "Expo Web export served by nginx :8090", "Browser client for administrators and instructors")
        Container(mobile, "Mobile App", "Expo / React Native (Android)", "Client used by students for facial-scan attendance")

        Container(gateway, "API Gateway", "Kong OSS 3.6 (DB-less) :8080 / :8001", "Single entry point: routing, CORS and rate limiting (redis policy). Plugins are only cors + rate-limiting — no jwt, the opaque sessionId is validated per service")

        Container(identity, "ms-identity", "Java 21 + Spring Boot", "Persons, users, sessions, authentication (opaque sessionId), password policy. Port 8081")
        Container(authorization, "ms-authorization", "Java 21 + Spring Boot", "Roles, permissions and role assignments (RBAC). Port 8082")
        Container(academic, "ms-academic", "TypeScript + Fastify", "Schools, programs, periods, cohorts, courses, actors and enrollments. Port 8083")
        Container(scheduling, "ms-scheduling", "Java 21 + Spring Boot", "Environments, schedule blocks and class sessions with anti-double-booking rules. Port 8084")
        Container(attendance, "ms-attendance", "Java 21 + Spring Boot", "Attendance records, justifications and supporting documents. Port 8085")
        Container(biometric, "ms-biometric", "Python 3.12 + FastAPI", "Facial and fingerprint embeddings, vector search. Port 8086")
        Container(configuration, "ms-configuration", "TypeScript + Fastify", "Academic/security configuration values and biometric update cases. Port 8087")
        Container(notification, "ms-notification", "Go 1.22 + Gin", "Alert types, alert lifecycle and the internal e-mail channel. Port 8088")
        Container(quality, "ms-quality", "TypeScript + Fastify", "ISO 25010 / 29110 / ISTQB quality tooling (not a bounded context). Port 8089")

        ContainerDb(postgres, "PostgreSQL 17", "faceattend_db", "One schema per bounded context: identity, authorization, academic, scheduling, attendance, biometric, configuration, notification (+ quality). No cross-schema FK")
        ContainerDb(mongodb, "MongoDB 7", "Document store with vector search", "Facial and fingerprint embeddings and match logs (ADR-003 — only polyglot exception)")
        ContainerDb(redis, "Redis 7", "Rate-limit store", "Kong rate-limiting counters")
        ContainerDb(kafka, "Kafka 3.x (KRaft) :9092", "Message broker", "Domain events between services (ADR-006). Producers only — no consumer exists yet (AT-006)")
    }

    System_Ext(countriesnow, "countriesnow.space", "External city and country catalog, called straight from the mobile client")
    System_Ext(smtp, "SMTP relay", "Delivers the password-recovery e-mail owned by ms-notification")

    Rel(student, web, "Uses", "HTTPS")
    Rel(student, mobile, "Uses", "HTTPS")
    Rel(instructor, web, "Uses", "HTTPS")
    Rel(admin, web, "Uses", "HTTPS")

    Rel(web, gateway, "API calls", "HTTPS / REST")
    Rel(mobile, gateway, "API calls", "HTTPS / REST")

    Rel(gateway, identity, "Routes /api/v1/persons, /users, /auth, /sessions, /cities, /password-policies", "HTTP / REST")
    Rel(gateway, authorization, "Routes /api/v1/roles, /permissions, /user-roles, /auth/evaluate, /users/{id}/roles", "HTTP / REST")
    Rel(gateway, academic, "Routes /api/v1/schools, /programs, /academic-periods, /cohorts, /courses, /academic-actors, /enrollments, plus /health/quality (Kong service quality-health points here)", "HTTP / REST")
    Rel(gateway, scheduling, "Routes /api/v1/environments, /schedule-blocks, /class-sessions (+ nested /blocks, /sessions)", "HTTP / REST")
    Rel(gateway, attendance, "Routes /api/v1/attendance-records, /justifications, /justification-types, /supporting-documents (+ nested)", "HTTP / REST")
    Rel(gateway, biometric, "Routes /api/v1/biometric", "HTTP / REST")
    Rel(gateway, configuration, "Routes /api/v1/academic-configurations, /security-configurations, /biometric-update-cases, /configurations", "HTTP / REST")
    Rel(gateway, notification, "Routes /api/v1/alert-types, /api/v1/alerts", "HTTP / REST")
    Rel(gateway, quality, "Routes /api/v1/quality (the /health/quality Kong service actually targets ms-academic)", "HTTP / REST")
    Rel(gateway, redis, "Rate-limit counters", "RESP")

    Rel(identity, postgres, "Reads / writes schema identity", "JDBC / SQL")
    Rel(authorization, postgres, "Reads / writes schema authorization", "JDBC / SQL")
    Rel(academic, postgres, "Reads / writes schema academic (pg pool, Drizzle schema for parity)", "SQL")
    Rel(scheduling, postgres, "Reads / writes schema scheduling", "JDBC / SQL")
    Rel(attendance, postgres, "Reads / writes schema attendance", "JDBC / SQL")
    Rel(notification, postgres, "Reads / writes schema notification", "SQL (pgx)")
    Rel(quality, postgres, "Reads / writes schema quality", "SQL (pg)")
    Rel(configuration, postgres, "Startup probe only (CREATE SCHEMA + SELECT 1, then pool.end()) — runtime data lives in MemoryStore, no schema is written", "SQL (pg, best effort)")

    Rel(biometric, mongodb, "Stores and searches embeddings, appends match logs", "Motor / MongoDB")

    Rel(identity, kafka, "Publishes identity-events, city-events, password-policy-events", "Async producer")
    Rel(authorization, kafka, "Publishes role-events, permission-events", "Async producer")
    Rel(academic, kafka, "Publishes academic-events (HTTP access log: method, url, status)", "Async producer")
    Rel(scheduling, kafka, "Publishes class-session-events, environment-events, schedule-block-events", "Async producer")
    Rel(attendance, kafka, "Publishes attendance-events, justification-events, justification-type-events, document-events — produces only, it does not consume", "Async producer")
    Rel(configuration, kafka, "Publishes configuration-events (HTTP access log: method, url, status)", "Async producer")

    Rel(mobile, countriesnow, "Reads country codes and city lists directly from the browser", "HTTPS / REST")

    Rel(identity, notification, "POST /api/v1/emails with the recovery code (internal network only, not routed through Kong)", "HTTP / REST")
    Rel(notification, smtp, "Sends the recovery e-mail (only template: verification_code)", "SMTP")
