# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de ambiente para desarrollo local
#
# Espejo del archivo real: `FULL/.env.example` (única fuente de verdad).
# Docker Compose lo carga automáticamente desde la raíz de `FULL/` y lo usa para
# interpolar `docker-compose.yml`, `database/` y `back-end/`.
#
# USO:  copy .env.example .env   (Windows)
#       cp .env.example .env     (Linux/macOS)
#
# NUNCA: commitear el archivo .env con valores reales.
#        Los valores reales de dev/staging/prod van en el vault.
#
# NO existen `DATABASE_URL`, `REDIS_URL`, `JWT_SECRET` ni claves JWT: la
# autenticación usa sesiones opacas (`identity.user_session`) y cada servicio
# obtiene su conexión por variables `POSTGRES_*`/`MONGO_*`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL 17 (1 instancia, 8 schemas de contexto + `quality`) ─────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=faceattend_db
POSTGRES_PORT=5432
FACEATTEND_LIQUIBASE_IMAGE=liquibase/liquibase:4.29.0

# ─── MongoDB 7 (vectores biométricos) ───────────────────────────────────────
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongopass
MONGO_DB=faceattend_biometric
MONGO_PORT=27017

# ─── Redis 7 (rate-limiting de Kong) ────────────────────────────────────────
REDIS_PORT=6379

# ─── Kafka 3.8 KRaft (eventos de dominio) ───────────────────────────────────
KAFKA_PORT=9092

# ─── Kong gateway ───────────────────────────────────────────────────────────
KONG_PROXY_PORT=8080
KONG_ADMIN_PORT=8001

# ─── Host binding ───────────────────────────────────────────────────────────
# BIND_IP limita todos los puertos que no son de borde (5432, 27017, 6379,
# 9092, 8001 y 8081-8089) al loopback. `0.0.0.0` los expone otra vez (depuración
# desde otro equipo). El proxy de Kong (8080) y el frontend (8090) siempre se
# publican en 0.0.0.0 porque los navegadores y los teléfonos necesitan acceder.
BIND_IP=127.0.0.1

# ─── Frontend web (Expo estático + nginx) ───────────────────────────────────
# 8090 no choca (8082 pertenece a ms-authorization) y está permitido por el
# CORS de Kong (3000 / 5173 / 8090).
FRONTEND_PORT=8090
# URL del backend que se inyecta en el build del frontend.
# Dispositivos físicos/emuladores deben usar la IP LAN del PC, p. ej.
# http://192.168.1.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# ─── Semillas de API de prueba (tools/seed-api-test-data, Node >= 20) ───────
SEED_USERNAME=seed.admin
SEED_PASSWORD=SeedAdmin123!
BOOTSTRAP_USERNAME=admin.faceattend
BOOTSTRAP_PASSWORD=Admin123!ChangeMe
